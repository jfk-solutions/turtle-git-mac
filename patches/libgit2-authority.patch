+static int turtlegit_url_format(git_str *out, git_net_url *url)
+{
+	if (!git_net_url_is_ipv6(url)) return git_net_url_fmt(out, url);
+	git_str host = GIT_STR_INIT;
+	git_net_url formatted = *url;
+	if (git_str_printf(&host, "[%s]", url->host) < 0) return -1;
+	formatted.host = host.ptr;
