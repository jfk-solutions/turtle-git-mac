    "helper_verb": "turtlegit-repository-diagnosis",
    "helper_wire": "TurtleGit RepositoryDiagnosis v1: canonical base64 JSON single line; exact reason/errorCode/errorClass/gitFile/detail/workdir/gitdir keys.",
    "outcomes": [
      "added",
      "alreadyRecordedAfterFailure; completed append is retained even if cancellation or process failure followed the actual write",
      "unchanged failure retains original diagnostic; uncertain recovery explicitly refuses rollback assumptions"
    ],
    "native_adaptations": [
      "Native Retry is explicit; it reopens the selected repository, never silently replays the failed Commit/Push/etc.",
      "Append uses the captured authoritative global file via --file, preventing a late --global selection/symlink change from writing beyond the authorized directory. The file remains protected global configuration on ordinary reads.",
      "Canonical root is displayed explicitly; original selected symlink and canonical target identities are both fenced.",
      "Literal directory names ending in /* are refused because Git interprets that value as broader recursive trust."
    ]
