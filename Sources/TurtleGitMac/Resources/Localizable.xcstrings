    "Revision(s) reverted. All changes are integrated into your working tree now.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisió(ns) restituïda/es. Tots els canvis s'han integrat en el seu arbre de treball."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Revize vráceny. Všechny změny jsou nyní začleněny do vašeho pracovního stromu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen der Revision(en) rückgängig gemacht. Alle Änderungen wurden in Ihren Arbeitsbaum integriert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revision(s) reverted. All changes are integrated into your working tree now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restituir revisión(ones). Todos los cambios se integrarán en tu copia de trabajado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Révision(s) revenue(s). Tous les changements sont intégrés dans votre arborescence de travail maintenant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リビジョンが取り消されました。変更はすべてワーキングツリーに今統合されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리비전을 되돌렸습니다. 모든 변경사항이 작업 공간에 합쳐집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisie(s) ongedaan gemaakt. Alle wijzigingen zijn nu opgenomen in uw werkmap."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisões revertidas. Todas as mudanças foram integradas em sua pasta de trabalho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Revizia(-ile) au fost inversate. Toate schimbările sunt acum integrate în structura dumneavoastră de lucru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведен откат ревизии(й). Все изменения проинтегрированы в вашу рабочую копию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Revision(en/erna) återställda. Alla ändringar finns nu i ditt arbetsträd."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீள்திருத்தம்(கள்) மாற்றியமைக்கப்பட்டது. எல்லா மாற்றங்களும் இப்போது உங்கள் பணிபுரியும் மரத்தில் ஒருங்கிணைக்கப்பட்டுள்ளன."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本已还原。所有的变更现在已集成到您的工作树。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修訂已還原，所有變更現已被納入工作目錄中。"
          }
        }
      }
    },
