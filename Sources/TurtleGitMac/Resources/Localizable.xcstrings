          "stringUnit": {
            "state": "translated",
            "value": "Mixto (mixed): Deja intacto el árbol de trabajo, restablece el índice"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prudent : Laisser l'arborescence de travail inchangée et réinitialiser l'index"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misto: Lascia albero attuale, reimposta indici"
          }
        },
