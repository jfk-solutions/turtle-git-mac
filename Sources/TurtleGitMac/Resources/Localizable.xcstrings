    "Branch/Tag name must not be empty or is invalid.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La branca/etiqueta no pot estar buida o ser invàlida."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Název větve/značky je buď neplatný nebo prázdný."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweig/Markierungsname darf nicht leer sein oder ist ungültig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όνομα Κλάδου/Σταθερού Κλάδου δεν πρέπει να είναι κενό η δεν είναι έγκυρο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Branch/Tag name must not be empty or is invalid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre Ramal/Etiqueta no debe estar vacío o no será válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom de branche/tag ne doit pas être vide ou est incorrecte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שם הענף/תג לא יכול להיות ריק או שאיננו תקין."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome del branch/tag non deve essere vuoto, altrimenti non è valido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブランチ/タグの名前が空であるか、無効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Branch/Tag name must not be empty or is invalid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Branch-/Tagnaam mag niet leeg zijn of is ongeldig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa gałęzi/tagu nie może być pusta lub jest nieprawidłowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nome do ramo/etiqueta não pode ser vazio ou é inválido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele de ramură/etichetă nu poate fi nul sau este invalid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя ветви/метки не должно быть пустым или неправильным."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namnet på gren/märke får inte vara tomt eller ogiltilgt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கிளை/குறிச்சொல் பெயர் காலியாக இருக்கக்கூடாது அல்லது செல்லாததாக இருக்கக்கூடாது."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อ Branch/Tag จะต้องไม่ว่างเปล่าหรือไม่ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal/Etiket adı boş ya da geçersiz olmamalıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên Nhánh/Thẻ đánh dấu không được để trống hoặc phải hợp lệ theo quy định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分支/标签名称必须非空且符合规定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「分支／標籤」名稱無效或空白"
          }
        }
      }
    },
