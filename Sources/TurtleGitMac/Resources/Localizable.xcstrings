    "WARNING:\nOnly change these settings if you are absolutely sure what you are doing!\nTo set the values to their default, delete the value text.": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "ВНИМАНИЕ!\nПроменяйте тези настройки само ако сте съвсем сигурни, че знаете какво правите!\nЗа да върните стойностите по подразбиране, изтрийте текста им."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "ADVERTIMENT:\nNo canvii aquestes opcions a menys que sàpiga exactament què està fent!\nPer a restaurar aquests elements al seu valor original, elimini el text."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "VAROVÁNÍ:\nTyto nastavení měňte, pouze pokud opravdu víte, co děláte!\nAbyste hodnoty nastavili na výchozí, smažte hodnotu text."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ACHTUNG:\nÄndern Sie diese Einstellungen nur, wenn Sie sich absolut sicher sind, was Sie tun!\nZum Rücksetzen auf den Standard, löschen Sie einfach den Wert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WARNING:\nOnly change these settings if you are absolutely sure what you are doing!\nTo set the values to their default, delete the value text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ADVERTENCIA:\n¡Cambia estos ajustes sólo si estás seguro de lo que estás haciendo!\nPara ajustar los valores a predeterminados, borra el valor del texto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "VAROITUS:\nMuuta näitä asetuksia vain, mikäli olet tiedät varmasti, mitä olet tekemässä!\nPoista asetuksen teksti palauttaaksesi oletusarvon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ATTENTION :\nNe changez ces paramètres qui si vous êtes absolument sûrs de ce que vous faites ! Pour remettre les valeurs par défaut, supprimez le texte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "FIGYELMEZTETÉS:\nCsak akkor változtassa meg ezeket a beállításokat, ha teljesen biztos abban amit csinál!\nAz alapérték visszaállításához, törölje a szöveget az érték mezőből."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PERINGATAN:\nHanya mengubah pengaturan ini jika Anda benar-benar yakin apa yang Anda lakukan!\nUntuk mengatur nilai-nilai standar mereka, menghapus teks nilai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ATTENZIONE:\nModificare queste impostazioni solo se si è assolutamente certi di ciò che si sta facendo!\nPer impostare i valori al valore predefinito, eliminare il relativo valore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "警告:\n何をしているか分からない場合はこれらの設定を変更しないでください。\nデフォルト値に設定するには、値を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경고:\n무엇을 하는지 절대적으로 확신할 수 있는 경우에만, 이 설정을 변경하십시오!\n기본값으로 되돌리려면 값을 삭제하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "WAARSCHUWING:\nWijzig deze instellingen alleen als u weet wat u doet!\nOm de standaardwaardes te gebruiken maakt u de tekst leeg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "UWAGA:\nZmieniaj te ustawienia tylko wtedy, kiedy jesteś pewien, co robisz!\nAby przywrócić wartości domyślne, wyczyść pola tekstowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "AVISO:\nSomente mude estas configurações se você tem certeza absoluta do que está fazendo!\nPara ajustar estes valores para o padrão, exclua o texto do valor."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "AVISO:\nModifica estas preferências só se tiveres a certeza absoluta de que sabes o que estás a fazer!\nPara reverteres para os valores originais, apaga o texto do valor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "ATENTIE:\nModificați aceste configurațiile doar dacș sunteți sigur că știți ce faceți!\nPentru a revenii la valorile implicite ștergeți textul valorii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВНИМАНИЕ:\nИзменяйте эти настройки, если вы точно знаете что делаете!\nДля сброса настроек, очистите значения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "VAROVANIE:\nMente tieto nastavenia len keď ste si úplne istý čo robíte!\nPre nastavenie do predvoleného stavu vymažte text hodnoty."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "PAŽNJA:\nMenjajte ova podešavanja samo ako ste apsolutno sigurni šta radite!\nDa postavite vrednosti na njihove podrazumevane vrednosti, obrišite tekst vrednosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "VARNING:\nÄndra endast dessa inställningar om du är absolut säkert på vad du gör!\nRadera värdet för att återställa till standardvärden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எச்சரிக்கை:\nநீங்கள் என்ன செய்கிறீர்கள் என்பதில் உறுதியாக இருந்தால் மட்டுமே இந்த அமைப்புகளை மாற்றவும்!\nமதிப்புகளை அவற்றின் இயல்புநிலைக்கு அமைக்க, மதிப்பு உரையை நீக்கவும்."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำเตือน:\nแก้ไขการตั้งค่าเหล่านี้เมื่อคุณแน่ใจโดยสมบูรณ์ว่ากำลังทำอะไรอยู่เท่านั้น\nลบข้อความทิ้งเพื่อใช้ค่าโดยปริยาย"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "УВАГА:\nЗмінюйте ці налаштування тільки якщо ви розумієте, що робите!\nЩоб повернути значення до типових, витріть їх."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CẢNH BÁO:\nChỉ thay đổi các thiết lập này nếu bạn tuyệt đối chắc chắn về những gì bạn đang làm!\nĐể đặt các giá trị về mặc định, hãy xóa các chữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "警告：\n仅在您明确知道这些设置的意义时修改它们！\n要恢复值到默认设置，删除值内容即可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "警告：\n當你明確地知道這些設定的意義時，才可以修改它們！\n要恢復預設設定，删除這些值即可。"
          }
        }
      }
    },
