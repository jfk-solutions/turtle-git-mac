    "Always push to the selected remote archive for this local branch": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Empeny sempre aquesta branca local a l'arxiu remot seleccionat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždy odesílat do zvoleného vzdáleného archivu pro tuto místní větev"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versende immer zum ausgewählten Projektarchiv für diesen lokalen Zweig"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάντα σπρώξε στην επιλεγμένη απομακρυσμένη συλλογή αρχείον για αυτόν τον τοπικό κλάδο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always push to the selected remote archive for this local branch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impulsar (push) siempre hacia el archivo remoto seleccionado para este ramal local"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours envoyer les modifications à l'archive distante sélectionnée pour cette branche locale"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui sempre il Push sull'archivio remoto selezionato per questo ramo locale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このローカルブランチでのpushを常に指定のリモートアーカイブへのプッシュとする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Always push to the selected remote archive for this local branch"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze wypychaj tę lokalną gałąź na wybrany zdalny zasób"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre empurrar para o arquivo remoto selecionado para este ramo local"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Împinge intotdeauna spre arhiva destinaţie selectată pentru această ramură locală"
