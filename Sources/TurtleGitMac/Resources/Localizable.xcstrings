    "Merge: Resets the index and try to reconstruct the pre-merge state": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusiona: Reinicialitza l'índex i mira de reconstruir la situació pre-fusió"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge: Setzt den Index zurück und versucht den Stand vor dem Zusammenführen wiederherzustellen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge: Resets the index and try to reconstruct the pre-merge state"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinar (merge): Restablece el índice y trata de reconstruir el estado pre-combinación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge : Réinitialise l'index et tente de reconstruire l'état avant merge"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージ: インデックスをリセットし、マージ前の状態の復元に試みる(E)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesclar: Restaura o índice e trenta reconstruir o estado antes da mesclagem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слияние: сбросить индекс и попытаться восстановить состояние перед слиянием"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒன்றிணைத்தல்: குறியீட்டை மீட்டமைத்து, இணைப்பதற்கு முந்தைய நிலையை மீண்டும் உருவாக்க முயற்சிக்கவும்"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并(E)：重置索引并尝试重建合并前的状态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge：重設「索引」，並試圖重建合併前的狀態。"
          }
        }
      }
    },
