    "Mixed: Leave working tree untouched, reset index": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixt: Deixa el directory de treball com estava, reinicialitza l'índex"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smíšené: Ponechat pracovní strom netknutý, index resetovat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemischt: Lässt die Arbeitsbaum unverändert, versetzt nur den Index."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μικτό: Το τρέχον δεντρό δεν θα υποστεί αλλαγές, επαναφορά του δείκτη"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixed: Leave working tree untouched, reset index"
          }
