    "If checked, double-clicking on a revision in the log list compares it with the previous revision": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако е включено, двойно щракване върху редакция в дневника ще я сравни с предишната редакция"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se selecciona, fent doble clic sobre una revisió a la llista del registre la compara amb la revisió prèvia"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud zaškrtnuto, dvojitým kliknutím na revizi v seznamu protokolů ji porovná s předchozí revizí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis valgt, sammenlignes der med den tidligere revision, når der dobbeltklikkes på en revision i loglisten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie diese Option, damit bei einem Doppelklick in der Logliste ein Vergleich mit der vorherigen Revision durchgeführt wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν τεθεί, διπλό κλίκ σε μία αναθεώρηση στον κατάλογο ιστορικού την συγκρίνει με την προηγούμεη αναθεώρηση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If checked, double-clicking on a revision in the log list compares it with the previous revision"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcandola, haciendo doble-clic sobre una revisión de la lista de registro se comparará con la revisión anterior"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در صورت انتخاب، دوبار کلیک روی یک اصلاحیه در لیست گزارشات آن را با اصلاحیه قبل مقایسه می کند"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikäli valittu, version kaksoisnapsautus lokissa vertaa sitä edellisen version kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si coché, double-cliquer sur une révision dans le journal la compare avec la révision précédente"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha be van jelölve és duplakattintunk napló listájában\negy verzióra, összehasonlítja azt az előző verzióval."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tercawang, mengeklik ganda pada suatu revisi pada daftar log akan membandingkannya dengan revisi sebelumnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se selezionato, facendo doppio clic su una revisione nel registro attività la confronta con la revisione precedente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、ログリスト内でリビジョンをダブルクリックすると直前のリビジョンと比較します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그 리스트에서 더블클릭하면 이전 리비전과 비교합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Activeer deze optie om met een dubbelklik op een reviesie in de log-lijst te vergelijken met de vorige versie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli zaznaczone, dwuklik na wersji w okienku dziennika porównuje ją z poprzednią wersją"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se marcado, um clique duplo em uma revisão na lista do histórico compara o item com sua revisão anterior"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se seleccionado, um duplo clique sobre uma revisão na lista de registo compara-a com a revisão anterior"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă este bifat, a face dublu-clic pe o revizie din lista de jurnale o va compara cu revizia precedentă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если отмечено, двойной щелчок на ревизии в списке сообщений сравнивает с её предыдущей"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak je zaškrtnuté, dvojklik na revíziu v denníku vyvolá porovnanie s predchádzajúcou revíziu"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če je možnost izbrana, dvoklik na revizijo v dnevniškem seznamu prikaže primerjavo s predhodno revizijo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако је означено, двоструки клик на ревизији у попису дневника ће упоредити фајл с прошлом ревизијом"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako je označeno, dvostruki klik na reviziji u popisu dnevnika će uporediti fajl s prošlom revizijom"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbelklicka på en revision i logglistan för att jämföra med föregående revision"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயக்கப்பட்டால், பதிவுப் பட்டியலில் உள்ள மீள்திருத்தத்தின் மீது இருமுறை சொடுக்கம் செய்தால், முந்தைய மீள்திருத்தத்துடன் ஒப்பிடும்"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eğer seçilmişse, kayıt listesindeki bir revizyonu çift tıklamak, onu önceki revizyon ile karşılaştırır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо позначено, то подвійне клацання на модифікації у логовому списку порівнює її з попередньою модифікацією"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu được đánh dấu, nháy kép chuột trên một bản chỉnh sửa trong danh sách tường trình so sánh nó với bản chỉnh sửa trước đó"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果选中该项，可以在日志列表中的一个版本上双击，将其与上一个版本比较"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果啟用，可以在日誌列表中的一個版本上雙擊與其前一版比較"
          }
        }
      }
    },
