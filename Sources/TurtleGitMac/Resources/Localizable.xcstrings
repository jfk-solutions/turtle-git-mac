    "Unversioned files mark parent folder as modified": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Неконтролираните файлове бележат съдържащата ги папка като променена"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els fitxers sense versionar marquen la carpeta contenidora com a modificada"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory bez verze označují nadřazenou složku jako změněnou"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke-versionerede filer viser overordnet mappe som ændret"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht versionierte Dateien markieren Elternordner als modifiziert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unversioned files mark parent folder as modified"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de la carpeta antecesora marcados como no versionados"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایلهای فاقد نسخه پوشه پدر را بعنوان تغییر یافته علامت میزنند"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Versioimattomat tiedostot merkitsevät yläkansion muutetuksi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers non versionnés marquent le dossier parent comme modifié"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a mappa tartalmaz nem verziókezelt fájlokat, módosítottnak látszik"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas tidak berversi menandai folder leluhur sebagai diubah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file senza versione marcano le cartelle che li contengono come modificate "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン管理外のファイルを含むフォルダーに変更マークを付ける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전관리 대상이 아닌 파일들이 있으면 상위 폴더를 수정된 것으로 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden zonder versiebeheer markeren map als gewijzigd"
          }
        },
        "oc": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fichièrs non versionats marquent lo dorsièr parent coma modificat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niewersjonowane pliki skutkują oznaczeniem nadrzędnego folderu jako zmodyfikowany"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos sem controle de versão marcam o diretório pai como modificado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirar o controlo de versão a arquivos leva a que as respectivas pastas pai sejam marcadas como modificadas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fişierele neversionate marchează dosarul părinte ca modificat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверсированные файлы помечают родительскую папку как изменённую"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Neverziované súbory označia rodičovský adresár za zmenený"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V primeru datotek brez različic označi nadrejeno mapo kot spremenjeno."
