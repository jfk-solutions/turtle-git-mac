        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strip lines starting with \"#\" in commit message"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Despojar de líneas que comiencen con \"#\" el mensaje de consignación (commit)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les lignes commençant par \"#\" dans le message de commit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミットメッセージにおいて、\"#\" で始まる行を取り除く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커밋 메시지에서 \"#\"으로 시작하는 줄은 지우기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder regels die beginnen met \"#\" uit commitbericht"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover linhas iniciadas com \"#\" em mensagens de submissão"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu afisa liniile care incep cu \"#\" in mesajul de transmitere"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищать от пробелов строки, начинающиеся с \"#\", в сообщении фиксации"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bortse från rader som börjar med \"#\" i arkiveringsmeddelandet"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உறுதிமொழி செய்தியில் \"#\" உடன் தொடங்கும் வரிகளை நீக்கு"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剥离提交信息中以 # 开头的行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除以「#」開頭的提交訊息"
