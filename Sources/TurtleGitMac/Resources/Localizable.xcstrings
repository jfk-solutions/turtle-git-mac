    "In order to abort a merge progress a reset (to HEAD) is needed.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cal reinicialitzar (a HEAD) per interrompre la fusió en curs"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um das Zusammenführen abzubrechen, ist ein Reset (auf HEAD) notwendig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In order to abort a merge progress a reset (to HEAD) is needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour interrompre une fusion, une remise à zéro (vers HEAD) est nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per interrompere un processo di merge è necessario un reset (su HEAD)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージ操作を中止するには、(HEADへの)リセットが必要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma reversão (para HEAD) é necessária para abortar um processo de mesclagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для прекращения процесса слияния необходимо восстановление (к ГОЛОВНОЙ ветви)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒன்றிணைப்பு முன்னேற்றத்தை நிறுத்த, ஒரு மீட்டமைப்பு (தலைக்கு) தேவை."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为中止当前的合并，需要重置 HEAD。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了中止合併程序，需要重設（至 HEAD）。"
          }
        }
      }
    },
