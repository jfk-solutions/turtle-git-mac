    "Can double-click in log list to compare with previous revision": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Двойно щракване върху редакция в дневника я сравнява с предишната редакция"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Doble clic a la llista de registre permet comparar amb la revisió prèvia"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V seznamu protokolů lze dvojklikem porovnat s předchozí revizí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan dobbeltklikke i loglisten for at sammenligne med tidligere revision"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelklick in Logliste, um mit vorheriger Revision zu vergleichen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορεί να διπλοκλικάρει στη λίστα καταγραφής για σύγκριση με προηγούμενη έκδοση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can double-click in log list to compare with previous revision"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede hacer doble-clic en la lista de registro para comparar con revisión anterior"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌توانید برای مقایسه با بازبینی قبلی در لیست گزارش دوبار کلیک کنید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit kaksoisnapsauttaa lokiviestiä verrataksesi sitä edellisen version kanssa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut double-cliquer dans la liste de l'historique pour comparer avec la révision précédente"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplakattintás a naplóban összehasonlítja az előző verzióval"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapat mengeklik ganda dalam daftar log untuk membandingkan dengan revisi sebelumnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "E' possibile fare doppio clic nell'elenco dei registri attività per confrontare con revisioni precedenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログリスト内のダブルクリックで直前のリビジョンと比較する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그 리스트에서 더블 클릭하면 이전 리비전과 비교할 수 있습니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Galima dukart-paspausti logo sąraše tam, kad būtų palyginta su prieš tai buvusia revizija"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbelklikken in de log-lijst vergelijkt met de vorige revisie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podwójne kliknięcie na liście zdarzeń porównuje z poprzednią wersją"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplo clique na lista do histórico para comparar com versão anterior"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça um duplo clique na lista de mensagens de registo para comparar com uma revisão anterior"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se poate face dublu-clic în lista de jurnale pentru a compara cu revizii precedente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить сравнение ревизии в списке с предыдущей по двойному щелчку"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojklik na zoznam denníka k porovnaniu s predchádzajúcou revíziou"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri dvokliku v seznamu zapisov primerjaj izbrano revizijo s predhodno"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Омогући двоструки клик у листи дневника за поређење с претходном ревизијом"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogući dvostruki klik u listi dnevnika za poređenje s prethodnom revizijom"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan dubbelklicka i logglistan för att jämföra med föregående revision"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முந்தைய மீள்திருத்தத்துடன் ஒப்பிட பதிவு பட்டியலில் இருமுறை சொடுக்கவும்"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir önceki revizyon ile karşılaştırmak icin günlüğün içine çift tıklama yapınız"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подвійний клік у списку логу порівнюе з попередньою ревізіею"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể nháy kép chuột vào danh sách các tường trình để so sánh với bản tường trình trước"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在日志列表中的一个版本上双击，与上一个版本比较"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
