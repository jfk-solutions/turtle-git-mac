    "Strip lines starting with \"#\" in commit message": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Treu les línies que comencen amb \"#\" en el missatge d'entrega"
          }
        },
        "cs": {
          "stringUnit": {
