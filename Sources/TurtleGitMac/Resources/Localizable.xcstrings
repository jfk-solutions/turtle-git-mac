    "The Remote Config was changed.\nDo you want to save now or discard changes?": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuració del remot ha canviat.\nVoleu desar-ho ara, o descartar els canvis?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzdálené nastavení bylo změněno.\nChcete ho uložit nebo změny zahodit?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Archivkonfiguration wurde geändert.\nMöchten Sie die Änderungen speichern?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Remote Config was changed.\nDo you want to save now or discard changes?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración remota ha cambiado\n¿Quieres guardar ahora o descartar los cambios?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration distante a été modifiée.\nVoulez-vous enregistrer maintenant ou annuler vos modifications?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート設定は変更されました。\n変更を保存しますか？または破棄しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "The Remote Config was changed.\nDo you want to save now or discard changes?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Externe Configuratie is gewijzigd.\nWilt u nu opslaan of de wijzigingen negeren?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Istnieją niezapisane modyfikacje!\nChcesz zapisać lub odrzucić zmiany?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Configuração Remota foi alterada.\nVocê quer salvar agora ou descartar as mudanças?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurarea destinaţie a fost schimbată.\nDoriţi să salvaţi acum sau renunţaţi la modificări?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки внешних хранилищ изменены.\nВы хотите сохранить или отменить изменения?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொலைநிலை கட்டமைப்பு மாற்றப்பட்டது.\nஇப்போது சேமிக்க வேண்டுமா அல்லது மாற்றங்களை நிராகரிக்க வேண்டுமா?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Віддалена конфігурація була змінена.\nВи хочете зберегти зараз, чи відмінити зміни?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远端配置已更改。\n您想保存还是放弃更改？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端組態已改變\n要「儲存」或「放棄變更」？"
          }
        }
      }
    },
    "The fetched branch fast-forwards upon the current branch.\n\nMerge or open the rebase dialog anyway?": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La branca recuperada avança ràpidament sobre la branca actual.\n\nFusiona o obre el diàleg de rebase de totes maneres?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Získaná větev rychle posouvá vpřed současnou větev.\n\nChcete přesto sloučit nebo otevřít dialogové okno přeskládání?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der geholte Zweig kann direkt auf den aktuellen Zweig angewendet werden (fast-forward).\n\nZusammenführen oder den \"Neu aufbauen\" Dialog trotzdem öffnen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κλάδος που αποκτήθηκε μεσώ της εντολής φέρνω αλλαγές στον τρέχον κλάδο.\n\nΣυγχώνευση ή άνοιγμα του διάλογου επαναφοράς κλάδου παρ' όλα αυτά;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fetched branch fast-forwards upon the current branch.\n\nMerge or open the rebase dialog anyway?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ramal descargado (fetch) representa un avance rápido sobre el ramal actual.\n\n¿Fusionar (merge) o abrir el cuadro de diálogo reasentar (rebase) de todas formas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La branche extraite avance rapidement sur la branche en cours.\n\nFusionner ou ouvrir la boîte de dialogue de rebase quand même?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フェッチしたブランチは、現在のブランチからファストフォワードで到達できます。\n\nマージするか、リベースダイアログを開きますか？"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gauta šaka neturi konfliktų su dabartine šaka.\n\nSujungti ar visvien atverti perkėlimo ir apjungimo langą?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ramo obtido avança rápido sobre o ramo atual.\n\nMesclar ou abrir a janela de reorganização assim mesmo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущая ветвь может быть быстро-перемотана вперёд до состояния полученной ветви.\n\nСлить изменения или открыть диалог перебазирования?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பெறப்பட்ட கிளை தற்போதைய கிளையில் வேகமாக முன்னோக்கி செல்கிறது.\n\nஎப்படியும் மறுதளம் உரையாடலை ஒன்றிணைக்கவா அல்லது திறக்கவா?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取的分支在当前分支的基础上进行快进。\n\n合并？或是仍然打开变基对话框？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已獲取的分支已快進到目前分支之上\n\n直接「快進合併」？或開啟「變基」視窗？"
          }
        }
      }
    },
    "The local branch name and the remote branch name are empty.\nContinue?": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La branques local i remota tenen noms buits.\nVol continuar?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Názvy místní i vzdálené větve jsou prázdné.\nChcete pokračovat?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Namen für den lokalen und entfernten Zweig sind leer.\nFortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local branch name and the remote branch name are empty.\nContinue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres del ramal local y del ramal remoto están vacíos.\n¿Continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms des branches locales et distantes ne doivent pas être vide.\nPoursuivre?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルブランチ名とリモートブランチ名が空です。\n続けますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "The local branch name and the remote branch name are empty.\nContinue?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lokale branchnaam en de externe branchnaam zijn leeg.\nDoorgaan?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwy lokalnej i zdalnej gałęzi są puste.\nKontynuować?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome do ramo local e do ramo remoto estão vazios.\nContinuar?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele ramurii locale şi numele ramurii destinaţie sunt goale.\nContinuaţi?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя локальной ветви и имя внешней ветви пустое.\nПродолжить?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det lokala grennamnet och fjärrgrennamnet är tomma.\nFortsätt?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளூர் கிளையின் பெயரும் தொலைதூரக் கிளையின் பெயரும் காலியாக உள்ளன.\nதொடரவா?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地和远端分支名称为空。继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地和遠端分支為空，繼續嗎？"
          }
        }
      }
    },
    "The local branch/tag name is empty. This results in a remote removal.\nContinue?": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha especificat la branca local. Aixo eliminara la branca remota.\nVol continuar?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Název místní větve/značky je prázdný. To má za následek odstranění vzdálené.\nPokračovat?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name des lokalen Zweiges/der lokalen Markierung ist leer. Dies führt zu einer Löschung im entfernten Projektarchiv.\nFortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local branch/tag name is empty. This results in a remote removal.\nContinue?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del ramal/etiqueta está vacío. Estó ocasionará el borrado del remoto.\n¿Continuar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom de la branche / étiquette locale est vide. Ceci implique la suppression de la copie distante.\nPoursuivre?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのブランチ/タグ名が入力されていません。リモートが削除されます。\n継続しますか?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lokale branch-/tagnaam is leeg. Dit resulteert in een externe verwijderactie.\nDoorgaan?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome do ramo/etiqueta está vazio. Isto resulta em uma remoção remota.\nContinuar?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele ramurii/etichetei locale este nul. Aceasta va cauza ştergerea destinaţiei.\nContinuaţi?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пустое имя локальной ветки/метки. Это приведет к удалению из внешнего хранилища.\nПродолжить?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det lokala gren/märkes-namnet är tomt. Detta kommer att resultera i en borttagning i fjärrarkivet.\nFortsätt?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளூர் கிளை/குறிச்சொல் பெயர் காலியாக உள்ளது. இதன் விளைவாக தொலைநிலை அகற்றப்படுகிறது.\nதொடரவா?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地分支/标签名称为空。这将导致一个远端分支/标签被删除。\n继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地的「分支／標籤」為空，這會導致刪除遠端的「分支／標籤」。繼續嗎？"
          }
        }
      }
    },
    "The remote branch has not changed.\n\nOpen the rebase dialog anyway?": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La branca remota no ha canviat.\n\nObro el diàleg rebase de totes maneres?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzdálená větev se nezměnila.\n\nChcete přesto otevřít dialogové okno přeskládání?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der entfernte Zweig wurde nicht geändert.\n\nMöchten Sie den \"Neu aufbauen\" Dialog trotzdem öffnen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο απομακρυσμένος κλάδος δεν έχει αλλάξει.\n\nΆνοιγμα του διάλογου επαναφοράς κλάδου παρ' όλα αυτά;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote branch has not changed.\n\nOpen the rebase dialog anyway?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ramal remoto no ha cambiado.\n\n¿Abrir el cuadro de diálogo reasentar (rebase) de todas formas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La branche distante n'a pas changé.\n\nOuvrir quand même la fenêtre de dialogue Rebase?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートブランチは変更されていません。\n\nともかくリベースダイアログを開きますか？"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutolusi šaka neturi pakeitimų.\n\nAr atverti perkėlimo ir apjungimo langą?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ramo remoto não foi modificado.\n\nAbrir a janela de reorganização assim mesmo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внешняя ветвь не изменена.\n\nОткрыть диалог перебазирования невзирая на?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொலைநிலை கிளை மாறவில்லை.\n\nஎப்படியும் மறுதள உரையாடலைத் திறக்கவா?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程分支未变更。\n\n仍然打开编辑对话框？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端分支並沒有改變。\n仍然要開啟「變基」視窗？"
          }
        }
      }
    },
