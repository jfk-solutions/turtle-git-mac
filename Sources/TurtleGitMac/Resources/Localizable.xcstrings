        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда отправлять в выбранное внешнее хранилище архив для этой локальной ветви"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusha alltid till det valda fjärrarkivet för denna lokala gren"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எப்போதும் இந்த உள்ளூர் கிளைக்காக தேர்ந்தெடுக்கப்பட்ட தொலைநிலை காப்பகத்திற்கு தள்ளவும்"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总是推送这个本地分支到选择的远端归档"
          }
