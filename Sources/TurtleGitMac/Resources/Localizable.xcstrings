    "Hard: Reset working tree and index (discard all local changes)": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Dur: Reinicialitza el directory de treball i l'índex (descarta tots els canvis locals)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvrdé: Resetovat pracovní strom a index (zahodit všechny místní změny)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hart: Ändert Arbeitsbaum und Index (verwirft alle Änderungen)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σκληρή: Επαναφορά τρέχοντος δέντρου και δείκτη (απόρριψη όλων τον τοπικών αλλαγών)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard: Reset working tree and index (discard all local changes)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duro (hard): Restablece el árbol de trabajo y el índice (descarta todos los cambios locales)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brutal : Réinitialiser l'arborescence de travail et l'index (annule toutes les modifications locales)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard: Ripristina l'albero di lavoro e l'indice (annulla tutte le modifiche locali)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard: 作業ツリーとインデックスをリセット（コミットしていない変更をすべて破棄）(H)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세게: 작업 공간과 관리 영역 전부 되돌리기 (모든 변경사항을 되돌림)(H)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sterk: Herstel de werkmap en index (maak alle lokale wijzigingen ongedaan)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twardy: resetuje katalog roboczy i indeks (odrzuca wszystkie lokalne zmiany)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard: Restaura a cópia de trabalho e o índice (descarta todas as mudanças locais)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жёсткий: Сбросить рабочую копию и индекс (отменить все локальные изменения)"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடினமான: பணிபுரியும் மரம் மற்றும் குறியீட்டை மீட்டமைக்கவும் (அனைத்து உள்ளூர் மாற்றங்களையும் நிராகரிக்கவும்)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard: ย้อนกับ working tree และ index (ละทิ้งการเปลี่ยนแปลงทุกอย่าง)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorla: Çalışma ağacını sıfırla ve indeksle (tüm yerel değişiklikleri iptal et)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硬重置(H)：重置工作区和索引（丢弃所有本地变更）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard：重設「工作目錄」和「索引」（放棄本地變更）。"
          }
        }
      }
    },
