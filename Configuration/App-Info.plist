<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>TurtleGit for Mac</string>
	<key>TurtleGitPortAuthor</key>
	<string>Jochen Kühner</string>
	<key>NSHumanReadableCopyright</key>
	<string>macOS port by Jochen Kühner. Based on TortoiseGit; see NOTICE for upstream credits.</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>TurtleGit</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.turtlegit.macos.action</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>turtlegit</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict><key>default</key><string>Open in TurtleGit</string></dict>
			<key>NSMessage</key>
			<string>openInTurtleGit</string>
			<key>NSPortName</key>
			<string>TurtleGit</string>
			<key>NSUserData</key>
			<string>open</string>
			<key>NSSendFileTypes</key>
			<array><string>public.item</string></array>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSRestricted</key>
			<true/>
		</dict>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>TurtleGit compares and prepares merges of your selected documents in Microsoft Word, compares selected workbooks in Microsoft Excel, exports selected presentations in Microsoft PowerPoint for native comparison and prepares drafts in Apple Mail. You review comparison results and send any mail yourself.</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.turtlegit.unified-diff</string>
			<key>UTTypeDescription</key>
			<string>TurtleGit Unified Diff</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>patch</string>
					<string>diff</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>text/x-patch</string>
					<string>text/x-diff</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleHelpBookFolder</key>
	<string>TurtleGitHelp.help</string>
	<key>CFBundleHelpBookName</key>
	<string>org.turtlegit.macos.help</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Unified Diff / Patch</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.turtlegit.unified-diff</string>
			</array>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>patch</string>
				<string>diff</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>TurtleGitPatch.icns</string>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
			<key>127.0.0.1</key>
			<dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
			<key>::1</key>
			<dict><key>NSExceptionAllowsInsecureHTTPLoads</key><true/></dict>
		</dict>
	</dict>
</dict>
</plist>
