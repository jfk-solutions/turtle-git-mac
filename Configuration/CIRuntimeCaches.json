      "scripts/validate-editorconfig-runtime.py",
      "scripts/pinned_download.py"
    ],
    "validate": [
      "python3",
      "scripts/validate-editorconfig-runtime.py",
      "build/editorconfig-runtime/EditorConfig"
    ]
  },
  "issue-regex": {
    "path": "build/issue-regex-runtime/IssueRegex",
    "inputs": [
