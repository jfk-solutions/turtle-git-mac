      "scripts/git_lfs_runtime.py",
      "scripts/runtime_bundle_layout.py"
    ],
    "validate": [
      "python3",
      "scripts/validate-git-svn-runtime.py",
      "build/git-svn-runtime/GitSVN",
      "--audit-only"
    ]
  },
  "metafile": {
