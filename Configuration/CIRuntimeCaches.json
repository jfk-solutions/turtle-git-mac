    ],
    "validate": [
      "python3",
      "scripts/validate-merge-diff-runtime.py",
      "build/merge-diff-runtime/MergeDiff"
    ]
  },
  "lexilla": {
    "path": "build/lexilla-runtime/Lexilla",
    "inputs": [
      "LICENSE",
      "Configuration/LexillaRuntime.json",
      "Configuration/BlameLexers.json",
      "Sources/TurtleGitLexilla/main.cpp",
      "Sources/TurtleGitLexilla/Scintilla/ILexer.h",
      "Sources/TurtleGitLexilla/Scintilla/Scintilla.h",
