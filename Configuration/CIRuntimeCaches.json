      "Sources/TurtleGitIssueRegex/main.cpp",
      "scripts/build-issue-regex-runtime.py",
      "scripts/validate-issue-regex-runtime.py"
    ],
    "validate": [
      "python3",
      "scripts/validate-issue-regex-runtime.py",
      "build/issue-regex-runtime/IssueRegex"
    ]
  },
  "openssh": {
    "path": "build/openssh-runtime/OpenSSH",
    "inputs": [
      "Configuration/OpenSSHRuntime.json",
      "scripts/build-openssh-runtime.py",
      "scripts/validate-openssh-runtime.py",
      "scripts/runtime_bundle_layout.py",
      "scripts/git_lfs_runtime.py",
      "scripts/pinned_download.py"
    ],
    "validate": [
      "python3",
      "scripts/validate-openssh-runtime.py",
      "build/openssh-runtime/OpenSSH"
    ]
  },
  "git": {
    "path": "build/git-runtime/Git",
    "inputs": [
      "Configuration/GitRuntime.json",
      "Configuration/GitLFSRuntime.json",
